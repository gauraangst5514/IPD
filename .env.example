# Local development only. Run commands from the repository root.
APP_ENV=development
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./work/intelliclaim.db
SECRET_KEY=development-only-change-before-any-deployment
ML_API_KEY=development-service-key
ML_SERVICE_URL=http://127.0.0.1:8001
